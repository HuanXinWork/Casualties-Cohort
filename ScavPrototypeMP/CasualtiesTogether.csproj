<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<AssemblyName>CasualtiesMP</AssemblyName>
		<Product>Together</Product>
		<Version>$(ModVersion)</Version>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
		<RestoreAdditionalProjectSources>
			https://api.nuget.org/v3/index.json;
			https://nuget.bepinex.dev/v3/index.json;
			https://nuget.samboy.dev/v3/index.json
		</RestoreAdditionalProjectSources>
		<RootNamespace>Together</RootNamespace>
		<AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
		<PackageProjectUrl>https://github.com/HuanXinPR/casualties-together</PackageProjectUrl>
		<PackageIcon>KSPMP_ICON.png</PackageIcon>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Configurations>Debug;Release;Playtest;DebugFullgame;ReleaseFullgame;PlaytestFullgame</Configurations>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<NoWarn>$(NoWarn);MSB3277</NoWarn>
		<DefineConstants>$(DefineConstants);UNITY_2018_3_OR_NEWER;UNITY_2019_1_OR_NEWER;UNITY_5_3_OR_NEWER;UNITY_2018_4_OR_NEWER;MP_GAMEMODES</DefineConstants>
		<StartAction>Program</StartAction>
		<StartProgram>$(GameDir)\CasualtiesUnknown.exe</StartProgram>
		<StartWorkingDirectory>$(GameDir)</StartWorkingDirectory>
	</PropertyGroup>

	<PropertyGroup Condition="'$(BuildType)'=='Debug'">
		<DebugType>portable</DebugType>
		<DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
	</PropertyGroup>

